{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-research-skill/schemas/claim-alignment-evidence.json",
  "title": "Claim-Source Alignment Evidence Bundle",
  "description": "Machine-readable evidence records and offline alignment audit inputs (issue #419). Production bundles bind report artifact path and route_id (issue #427: no byte-identity hashes). Gold labels are calibration-only.",
  "schema_version": "2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "audited_population",
    "sampling_rule",
    "source_artifact_path",
    "route_id",
    "source_register",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_version": {
      "type": "string",
      "minLength": 1
    },
    "audited_population": {
      "type": "string",
      "minLength": 1
    },
    "sampling_rule": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact_path": {
      "type": "string",
      "minLength": 1
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "source_register": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_register_entry"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/alignment_entry"
      }
    },
    "gold_labels": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/gold_label"
      }
    }
  },
  "$defs": {
    "source_register_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_artifact_path"],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_artifact_path": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "page",
            "section",
            "paragraph",
            "quote",
            "url_fragment",
            "none"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "source_id",
        "locator",
        "retrieval_status",
        "evidence_role"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "retrieval_status": {
          "type": "string",
          "enum": ["fetched", "unavailable", "unreadable", "not_run"]
        },
        "evidence_role": {
          "type": "string",
          "enum": ["primary", "secondary", "inferred", "unknown"]
        }
      }
    },
    "subclaim_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subclaim_judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "verdict"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "AMBIGUOUS",
            "RETRIEVAL_FAILED",
            "NOT_RUN"
          ]
        }
      }
    },
    "alignment_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_text",
        "evidence_record",
        "excerpt"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_text": {
          "type": "string",
          "minLength": 1
        },
        "evidence_record": {
          "$ref": "#/$defs/evidence_record"
        },
        "excerpt": {
          "type": "string"
        },
        "subclaim_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/subclaim_candidate"
          }
        },
        "artifact_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gold_label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "AMBIGUOUS",
            "RETRIEVAL_FAILED",
            "NOT_RUN"
          ]
        },
        "subclaims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/subclaim_judgment"
          }
        }
      }
    }
  }
}
